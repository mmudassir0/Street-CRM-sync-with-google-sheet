# Street Open API Base URL
# Default production/sandbox URL: https://street.co.uk/open-api/v1
# If your sandbox uses a specific staging host, replace it here:
STREET_API_BASE_URL=https://street.co.uk/open-api/v1

# Comma-separated list of Street CRM endpoints to sync into separate tabs
# Available standard endpoints: properties, viewings, offers, applicants, tenancies, landlords
STREET_OBJECTS=properties,viewings,offers,applicants,tenancies,landlords

# ==============================================================================
# Google Sheets API Configuration
# ==============================================================================
# The Google Sheet ID from your sheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Local path to your Google Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# (Optional - Alternative for CI/CD / GitHub Actions without file upload)
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
# GOOGLE_SERVICE_ACCOUNT_BASE64=
